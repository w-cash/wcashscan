# WcashExplorer network selection. Use one build per network.
NEXT_PUBLIC_NETWORK=testnet

# Local API supplied by the Wcash indexer/API service.
NEXT_PUBLIC_TESTNET_API_URL=http://localhost:3001

# Optional: until mainnet exists this intentionally falls back to the testnet
# API. Set this when the Wcash mainnet API is live; no UI code should change.
# NEXT_PUBLIC_MAINNET_API_URL=https://replace-with-wcash-mainnet-api.example

# Optional site URLs for the network switcher. Leaving these unset keeps local
# mainnet/testnet previews on the same local origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_MAINNET_URL=https://replace-with-wcash-mainnet-site.example
# NEXT_PUBLIC_TESTNET_URL=https://replace-with-wcash-testnet-site.example

# Optional Wcash display overrides while the chain spec settles.
# NEXT_PUBLIC_MAINNET_CURRENCY=WCASH
# NEXT_PUBLIC_TESTNET_CURRENCY=TWC
# NEXT_PUBLIC_DONATION_ADDRESS=
