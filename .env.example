# W.cash network identity for metadata, canonical URLs, APIs, and currency.
# Hosted builds must set this explicitly: mainnet or testnet.
# Mainnet is a Testnet-data preview until a verified Wcash mainnet profile exists.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_DATA_NETWORK=wcash-testnet-v5
NEXT_PUBLIC_TESTNET_URL=http://localhost:3000
NEXT_PUBLIC_MAINNET_URL=http://localhost:3002

# API origin overrides. These values are embedded in the browser bundle at build
# time. Omit them only when using the local API fallback.
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_TESTNET_API_URL=http://localhost:3001
# NEXT_PUBLIC_MAINNET_API_URL=http://localhost:3001
# WCASHEXPLORER_API_URL=http://api:3001

# Optional mainnet block sitemap pilot. Leave both unset to disable block shards.
# Values must cover complete, aligned 50,000-height buckets. For example, a tip
# near 3,412,933 uses 3,350,000 through 3,449,999 (two sitemap files).
# SITEMAP_BLOCK_MIN_HEIGHT=3350000
# SITEMAP_BLOCK_MAX_HEIGHT=3449999

# Optional Wcash CompactTxStreamer configuration for the gated wallet scanner.
WCASH_COMPACT_GRPC_URL=

# Privacy: disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Wcash RPC/indexer configuration is intentionally private and server-side.
WCASH_RPC_URL=http://127.0.0.1:38232
WCASH_RPC_COOKIE_FILE=/path/to/wcash-rpc-cookie
WCASH_INDEXER_GRPC_URL=
BLOCK_SPOOL_PATH=/var/lib/wcash-indexer/block-spool
MAX_REORG_DEPTH=100
