# Optional matching Wolf RocksDB state directory. RPC is the portable default.
WCASH_STATE_PATH=/var/lib/wcash/wolf/state/testnet
WCASH_SOURCE=rpc
WCASH_CHAIN=wcash-testnet-v5
WCASH_EXPECTED_GENESIS=0271b5b0a10b2838f43cccdec9ca2f72aa72a7c103830082bac8f82f47f0593a
WCASH_EXPECTED_BRANCH_ID=b3cfd27e
WCASH_RPC_URL=http://127.0.0.1:38232
WCASH_RPC_COOKIE_FILE=/var/lib/wcash/wolf/testnet/.cookie
DATABASE_URL=postgres://wcashscan:replace_me@127.0.0.1:5432/wcashscan_testnet_v5
BATCH_SIZE=1000

# RocksDB tuning (default: 256)
# MAX_OPEN_FILES=256

# Maximum automatic reorg depth and recent-block spool retention (default: 100)
# MAX_REORG_DEPTH=100

# Local W.cash regtest alternative:
# WCASH_CHAIN=wcash-regtest
# WCASH_EXPECTED_GENESIS=70bf0bab17eff361a6331bb825b3b7253c8c96ff96407f948161d2912658bb1c
# WCASH_EXPECTED_BRANCH_ID=c3a6678a
# WCASH_RPC_URL=http://127.0.0.1:48232
# WCASH_RPC_COOKIE_FILE=/var/lib/wcash/wolf/regtest/.cookie

# Live-mode Wolf indexer endpoint (optional)
# WCASH_INDEXER_GRPC_URL=http://127.0.0.1:38230
# Keep false until `cipherscan-indexer shadow` passes against the deployed node.
# ENABLE_FULL_BLOCK_GRPC=false
# GRPC_PAYLOAD_CACHE_BLOCKS=32
# GRPC_PAYLOAD_CACHE_BYTES=67108864
# GRPC_PAYLOAD_WAIT_MS=1500
# BLOCK_SPOOL_PATH=/var/lib/wcash-indexer/block-spool
# LIVE_PIPELINE_CAPACITY=4

# Optional health alerts via Telegram
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# INDEXER_MAX_LAG=3
# INDEXER_MAX_CONSECUTIVE_FAILURES=0
# INDEXER_MAX_HEARTBEAT_AGE_SECONDS=600
# INDEXER_MAX_INGEST_MS=5000
# INDEXER_ALERT_COOLDOWN_SECONDS=1800

# Emergency rollback only: set to any value to restore per-row SQL writes.
# WCASHSCAN_ROWWISE_WRITES=1
