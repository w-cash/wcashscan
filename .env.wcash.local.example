# W.cash Explorer local contract. Copy to .env.wcash.local and keep the copy
# private; this file contains placeholders only.
WCASH_CHAIN=wcash-testnet-v5
WCASH_EXPECTED_GENESIS=0271b5b0a10b2838f43cccdec9ca2f72aa72a7c103830082bac8f82f47f0593a
WCASH_WOLF_IMAGE=<image-built-from-pinned-wolf>
WCASH_WOLF_CONFIG_FILE=/absolute/path/to/wcash-testnet.toml
WCASH_RPC_URL=http://wolf:38232
# This is the path inside the shared wcash-wolf-data volume. It must match
# Wolf's configured cookie_dir; do not assume a legacy Zebra cookie location.
WCASH_RPC_COOKIE_FILE=/var/lib/wcash/wolf-rpc/.cookie
WCASH_RPC_SOURCE=rpc

# For local W.cash regtest, switch all four values together:
# WCASH_CHAIN=wcash-regtest
# WCASH_EXPECTED_GENESIS=70bf0bab17eff361a6331bb825b3b7253c8c96ff96407f948161d2912658bb1c
# WCASH_WOLF_NETWORK=regtest
# WCASH_WOLF_RPC_BIND_PORT=48232
# WCASH_WOLF_CONFIG_FILE=/absolute/path/to/wcash-regtest.toml
# WCASH_RPC_URL=http://wolf:48232
# WCASH_RPC_COOKIE_FILE=/var/lib/wcash/wolf-rpc-regtest/.cookie
# WCASH_RPC_PORT=48232
# WCASH_DB_NAME=wcashscan_regtest

# Empty means the indexer uses bounded RPC polling. Indexer gRPC and the
# CompactTxStreamer are separate services and must not share this value.
WCASH_INDEXER_GRPC_URL=
WCASH_COMPACT_GRPC_URL=
ENABLE_FULL_BLOCK_GRPC=0
BLOCK_SPOOL_PATH=/var/lib/wcash-indexer/block-spool
MAX_REORG_DEPTH=100

DB_HOST=postgres
DB_PORT=5432
DB_NAME=wcashscan_testnet_v5
DB_USER=wcashscan
DB_PASSWORD=<set-privately>
POSTGRES_ADMIN_PASSWORD=<set-privately>
REDIS_HOST=redis
REDIS_PORT=6379
API_CACHE_NAMESPACE=wcash-testnet-v5-0271b5b0
API_LIST_CACHE_ENABLED=1
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# NEXT_PUBLIC_* values are build-time inputs, not runtime container inputs.
NEXT_PUBLIC_DATA_NETWORK=wcash-testnet-v5
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TESTNET_API_URL=http://localhost:3001
NEXT_PUBLIC_MAINNET_URL=http://localhost:3002
NEXT_PUBLIC_TESTNET_URL=http://localhost:3000
NEXT_PUBLIC_NETWORK=testnet
NEXT_TELEMETRY_DISABLED=1
